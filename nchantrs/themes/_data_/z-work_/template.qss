/* QDarkStyleSheet --------------------------------------------------------
This is the main style sheet, the palette has nine main colors.
It is based on three selecting colors, three greyish (background) colors
plus three whitish (foreground) colors. Each set of widgets of the same
type have a header like this:
  ------------------
  GroupName --------
  ------------------
And each widget is separated with a header like this:
  QWidgetName ------
This makes more easy to find and change some css field. The basic
configuration is described bellow.
  SELECTION ------------
    sel_light  #179AE0 <[highlight]> (selection/hover/active)
    sel_normal #3375A3 <[highlight]> (selected)
    sel_dark   #18465D #14506E (selected disabled)
  FOREGROUND -----------
    for_light  #EFF0F1 <[foreground]> (texts/labels)
    for_dark   #505F69 <[color]> (disabled texts)
  BACKGROUND -----------
    bac_light  #4D545B #505F69 (unpressed)
    bac_normal #31363B <[accent]> (border, disabled, pressed, checked, toolbars, menus)
    bac_dark   #232629 <[color]> (background)
If a stranger configuration is required because of a bugfix or anything
else, keep the comment on that line to nobodys changed it, including the
issue number.
--------------------------------------------------------------------------- */
/* QWidget ---------------------------------------------------------------- */
QWidget {
  background-color: #000000;
  border: 0px solid <[accent]>;
  padding: 0px;
  color: <[foreground]>;
  selection-background-color: <[highlight]>;
  selection-color: <[foreground]>;
}
QWidget:disabled {
  background-color: <[color]>;
  color: <[color]>;
  selection-background-color: #14506E;
  selection-color: <[color]>;
}
QWidget:item:selected {
  background-color: <[highlight]>;
}
QWidget:item:hover {
  background-color: <[highlight]>;
  color: <[accent]>;
}
/* QMainWindow ------------------------------------------------------------ */
/* This adjusts the splitter in the dock widget, not qsplitter        */
QMainWindow::separator {
  background-color: <[accent]>;
  border: 0 solid <[color]>;
  spacing: 0;
  padding: 2px;
}
QMainWindow::separator:hover {
  background-color: #505F69;
  border: 0px solid <[highlight]>;
}
QMainWindow::separator:horizontal {
  width: 5px;
  margin-top: 2px;
  margin-bottom: 2px;
  image: url(:/qss_icons/rc/Vsepartoolbar.png);
}
QMainWindow::separator:vertical {
  height: 5px;
  margin-left: 2px;
  margin-right: 2px;
  image: url(:/qss_icons/rc/Hsepartoolbar.png);
}
/* QToolTip --------------------------------------------------------------- */
QToolTip {
  background-color: <[highlight]>;
  border: 1px solid <[color]>;
  color: <[color]>;
  padding: 0;   /*remove padding, for fix combo box tooltip*/
  opacity: 230; /*reducing transparency to read better*/
}
QStatusBar {
  border: 1px solid <[accent]>;
}
QStatusBar QToolTip {
  background-color: <[highlight]>;
  border: 1px solid <[color]>;
  color: <[color]>;
  padding: 0;   /*remove padding, for fix combo box tooltip*/
  opacity: 230; /*reducing transparency to read better*/
}
/* QCheckBox -------------------------------------------------------------- */
QCheckBox {
  border-radius: 4px;
  spacing: 4px;
  outline: none;
  padding-top: 4px;
  padding-bottom: 4px;
  padding-left: 8px;
  padding-right: 8px;
}
/* QGroupBox -------------------------------------------------------------- */
QGroupBox {
  background-color: #000000;
  font-weight: bold;
  border: 1px solid <[accent]>;
  border-radius: 4px;
  padding: 4px;
  margin-top: 16px;
}
QGroupBox::title {
  subcontrol-origin: margin;
  subcontrol-position: top left;
  left: 3px;
  padding-left: 3px;
  padding-right: 5px;
  padding-top: 8px;
  padding-bottom: 16px;
}
QGroupBox::indicator {
  margin-left: 4px;
  width: 16px;
  height: 16px;
}
QGroupBox::indicator {
  margin-left: 2px;
}
QGroupBox::indicator:unchecked:hover,
QGroupBox::indicator:unchecked:focus,
QGroupBox::indicator:unchecked:pressed {
  border: none;
  image: url(:/qss_icons/rc/checkbox_unchecked_focus.png);
}
QGroupBox::indicator:checked:hover,
QGroupBox::indicator:checked:focus,
QGroupBox::indicator:checked:pressed {
  border: none;
  image: url(:/qss_icons/rc/checkbox_checked_focus.png);
}
QGroupBox::indicator:checked:disabled {
  image: url(:/qss_icons/rc/checkbox_checked_disabled.png);
}
QGroupBox::indicator:unchecked:disabled {
  image: url(:/qss_icons/rc/checkbox_unchecked_disabled.png);
}
/* QRadioButton ----------------------------------------------------------- */
QRadioButton {
  background-color: <[color]>;
  color: <[foreground]>;
  spacing: 0;
  padding: 0;
  border: none;
  outline: none;
}
QRadioButton:focus {
  border: none;
}
QRadioButton:disabled {
  background-color: <[color]>;
  color: <[color]>;
  border: none;
  outline: none;
}
QRadioButton QWidget {
  background-color: <[color]>;
  color: <[foreground]>;
  spacing: 0px;
  padding: 0px;
  outline: none;
  border: none;
}
QRadioButton::indicator {
  border: none;
  outline: none;
  margin-bottom: 2px;
  width: 25px;
  height: 25px;
}
QRadioButton::indicator:unchecked {
  image: url(:/qss_icons/rc/radio_unchecked.png);
}
QRadioButton::indicator:unchecked:hover,
QRadioButton::indicator:unchecked:focus,
QRadioButton::indicator:unchecked:pressed {
  border: none;
  outline: none;
  image: url(:/qss_icons/rc/radio_unchecked_focus.png);
}
QRadioButton::indicator:checked {
  border: none;
  outline: none;
  image: url(:/qss_icons/rc/radio_checked.png);
}
QRadioButton::indicator:checked:hover,
QRadioButton::indicator:checked:focus,
QRadioButton::indicator:checked:pressed {
  border: none;
  outline: none;
  image: url(:/qss_icons/rc/radio_checked_focus.png);
}
QRadioButton::indicator:checked:disabled {
  outline: none;
  image: url(:/qss_icons/rc/radio_checked_disabled.png);
}
QRadioButton::indicator:unchecked:disabled {
  image: url(:/qss_icons/rc/radio_unchecked_disabled.png);
}
/* QMenuBar --------------------------------------------------------------- */
QMenuBar {
  background-color: <[accent]>;
  padding: 2px;
  border: 1px solid <[color]>;
  color: <[foreground]>;
}
QMenuBar:focus {
  border: 1px solid <[highlight]>;
}
QMenuBar::item {
  background: transparent;
  padding: 4px;
}
QMenuBar::item:selected {
  padding: 4px;
  background: transparent;
  border: 0px solid <[accent]>;
}
QMenuBar::item:pressed {
  padding: 4px;
  border: 0px solid <[accent]>;
  background-color: <[highlight]>;
  color: <[foreground]>;
  margin-bottom: 0px;
  padding-bottom: 0px;
}
/* QMenu ------------------------------------------------------------------ */
QMenu {
  border: 0px solid <[accent]>;
  color: <[foreground]>;
  margin: 0px;
}
QMenu::separator {
  height: 2px;
  background-color: #505F69;
  color: <[foreground]>;
  padding-left: 4px;
  margin-left: 2px;
  margin-right: 2px;
}
QMenu::icon {
  margin: 0px;
  padding-left:4px;
}
QMenu::item {
  padding: 4px 24px 4px 24px;
  border: 1px transparent <[accent]>;  /* reserve space for selection border */
}
QMenu::item:selected {
  color: <[foreground]>;
}
QMenu::indicator {
  width: 12px;
  height: 12px;
  padding-left:6px;
}
/* non-exclusive indicator = check box style indicator (see QActionGroup::setExclusive) */
QMenu::indicator:non-exclusive:unchecked {
  image: url(:/qss_icons/rc/checkbox_unchecked.png);
}
QMenu::indicator:non-exclusive:unchecked:selected {
  image: url(:/qss_icons/rc/checkbox_unchecked_disabled.png);
}
QMenu::indicator:non-exclusive:checked {
  image: url(:/qss_icons/rc/checkbox_checked.png);
}
QMenu::indicator:non-exclusive:checked:selected {
  image: url(:/qss_icons/rc/checkbox_checked_disabled.png);
}
/* exclusive indicator = radio button style indicator (see QActionGroup::setExclusive) */
QMenu::indicator:exclusive:unchecked {
  image: url(:/qss_icons/rc/radio_unchecked.png);
}
QMenu::indicator:exclusive:unchecked:selected {
  image: url(:/qss_icons/rc/radio_unchecked_disabled.png);
}
QMenu::indicator:exclusive:checked {
  image: url(:/qss_icons/rc/radio_checked.png);
}
QMenu::indicator:exclusive:checked:selected {
  image: url(:/qss_icons/rc/radio_checked_disabled.png);
}
QMenu::right-arrow {
  margin: 5px;
  image: url(:/qss_icons/rc/right_arrow.png)
}
/* QAbstractItemView ------------------------------------------------------ */
QAbstractItemView {
  alternate-background-color: <[color]>;
  color: <[foreground]>;
  border: 1px solid <[accent]>;
  border-radius: 4px;
}
QAbstractItemView QLineEdit {
  padding: 2px;
}
/* QAbstractScrollArea ---------------------------------------------------- */
QAbstractScrollArea {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  border-radius: 4px;
  padding: 4px;
  color: <[foreground]>;
}
QAbstractScrollArea:disabled {
  color: <[color]>;
}
/* QScrollArea ------------------------------------------------------------ */
QScrollArea QWidget QWidget:disabled {
  background-color: <[color]>;
}
/* QScrollBar ------------------------------------------------------------- */
QScrollBar:horizontal {
  height: 16px;
  margin: 2px 16px 2px 16px;
  border: 1px solid <[accent]>;
  border-radius: 4px;
  background-color: <[color]>;
}
QScrollBar::handle:horizontal {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  border-radius: 4px;
  min-width: 8px;
}
QScrollBar::handle:horizontal:hover {
  background-color: <[highlight]>;
  border: 1px solid <[highlight]>;
  border-radius: 4px;
  min-width: 8px;
}
QScrollBar::add-line:horizontal {
  margin: 0px 0px 0px 0px;
  border-image: url(:/qss_icons/rc/right_arrow_disabled.png);
  width: 10px;
  height: 10px;
  subcontrol-position: right;
  subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal {
  margin: 0px 3px 0px 3px;
  border-image: url(:/qss_icons/rc/left_arrow_disabled.png);
  height: 10px;
  width: 10px;
  subcontrol-position: left;
  subcontrol-origin: margin;
}
QScrollBar::add-line:horizontal:hover,
QScrollBar::add-line:horizontal:on {
  border-image: url(:/qss_icons/rc/right_arrow.png);
  height: 10px;
  width: 10px;
  subcontrol-position: right;
  subcontrol-origin: margin;
}
QScrollBar::sub-line:horizontal:hover,
QScrollBar::sub-line:horizontal:on {
  border-image: url(:/qss_icons/rc/left_arrow.png);
  height: 10px;
  width: 10px;
  subcontrol-position: left;
  subcontrol-origin: margin;
}
QScrollBar::up-arrow:horizontal,
QScrollBar::down-arrow:horizontal {
  background: none;
}
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: none;
}
QScrollBar:vertical {
  background-color: <[color]>;
  width: 16px;
  margin: 16px 2px 16px 2px;
  border: 1px solid <[accent]>;
  border-radius: 4px;
}
QScrollBar::handle:vertical {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  min-height: 8px;
  border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
  background-color: <[highlight]>;
  border: 1px solid <[highlight]>;
  border-radius: 4px;
  min-height: 8px;
}
QScrollBar::sub-line:vertical {
  margin: 3px 0px 3px 0px;
  border-image: url(:/qss_icons/rc/up_arrow_disabled.png);
  height: 10px;
  width: 10px;
  subcontrol-position: top;
  subcontrol-origin: margin;
}
QScrollBar::add-line:vertical {
  margin: 3px 0px 3px 0px;
  border-image: url(:/qss_icons/rc/down_arrow_disabled.png);
  height: 10px;
  width: 10px;
  subcontrol-position: bottom;
  subcontrol-origin: margin;
}
QScrollBar::sub-line:vertical:hover,
QScrollBar::sub-line:vertical:on {
  border-image: url(:/qss_icons/rc/up_arrow.png);
  height: 10px;
  width: 10px;
  subcontrol-position: top;
  subcontrol-origin: margin;
}
QScrollBar::add-line:vertical:hover,
QScrollBar::add-line:vertical:on {
  border-image: url(:/qss_icons/rc/down_arrow.png);
  height: 10px;
  width: 10px;
  subcontrol-position: bottom;
  subcontrol-origin: margin;
}
QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical {
  background: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: none;
}
/* QTextEdit--------------------------------------------------------------- */
QTextEdit {
  background-color: #FFFFFF;  /*<[color]>;*/
  color: #000000;
  border: 1px solid <[accent]>;
}
QTextEdit:hover {
  border: 1px solid <[highlight]>;
  color: #000000;
}
QTextEdit:selected {
  background: <[highlight]>;
  color: #000000;
}
/* QPlainTextEdit --------------------------------------------------------- */
QPlainTextEdit {
  background-color: <[color]>;
  color: <[foreground]>;
  border-radius: 4px;
  border: 1px solid <[accent]>;
}
QPlainTextEdit:hover {
  border: 1px solid <[highlight]>;
  color: <[foreground]>;
}
QPlainTextEdit:selected {
  background: <[highlight]>;
  color: <[accent]>;
}
/* QSizeGrip --------------------------------------------------------------- */
QSizeGrip {
  image: url(:/qss_icons/rc/sizegrip.png);
  width: 12px;
  height: 12px;
}
/* QStackedWidget --------------------------------------------------------- */
QStackedWidget {
  padding: 4px;
  border: 1px solid <[accent]>;
  border: 1px solid <[color]>;
}
/* QToolBar --------------------------------------------------------------- */
QToolBar {
  background-color: <[accent]>;
  border-bottom: 1px solid <[color]>;
  padding: 2px;
  font-weight: bold;
  color: #FFFFFF;
}
QToolBar QToolButton{
  background-color: <[accent]>;
  color: #FFFFFF;
}
QToolBar::handle:horizontal {
  width: 6px;
  image: url(:/qss_icons/rc/Hmovetoolbar.png);
}
QToolBar::handle:vertical {
  height: 6px;
  image: url(:/qss_icons/rc/Vmovetoolbar.png);
}
QToolBar::separator:horizontal {
  width: 3px;
  image: url(:/qss_icons/rc/Hsepartoolbar.png);
}
QToolBar::separator:vertical {
  height: 3px;
  image: url(:/qss_icons/rc/Vsepartoolbar.png);
}
QToolButton#qt_toolbar_ext_button {
  background: <[accent]>;
  border: 0px;
  color: <[foreground]>;
  image: url(:/qss_icons/rc/right_arrow.png);
}
/* QAbstractSpinBox ------------------------------------------------------- */
QAbstractSpinBox {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  color: <[foreground]>;
  padding-top: 2px;   /* This fix  103, 111*/
  padding-bottom: 2px;  /* This fix  103, 111*/
  padding-left: 4px;
  padding-right: 4px;
  border-radius: 4px;
  /* min-width: 5px; removed to fix 109 */
}
QAbstractSpinBox:up-button {
  background-color: transparent <[color]>;
  subcontrol-origin: border;
  subcontrol-position: top right;
  border-left: 1px solid <[accent]>;
  margin: 1px;
}
QAbstractSpinBox::up-arrow,
QAbstractSpinBox::up-arrow:disabled,
QAbstractSpinBox::up-arrow:off {
  image: url(:/qss_icons/rc/up_arrow_disabled.png);
  width: 9px;
  height: 9px;
}
QAbstractSpinBox::up-arrow:hover {
  image: url(:/qss_icons/rc/up_arrow.png);
}
QAbstractSpinBox:down-button {
  background-color: transparent <[color]>;
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  border-left: 1px solid <[accent]>;
  margin: 1px;
}
QAbstractSpinBox::down-arrow,
QAbstractSpinBox::down-arrow:disabled,
QAbstractSpinBox::down-arrow:off {
  image: url(:/qss_icons/rc/down_arrow_disabled.png);
  width: 9px;
  height: 9px;
}
QAbstractSpinBox::down-arrow:hover {
  image: url(:/qss_icons/rc/down_arrow.png);
}
QAbstractSpinBox:hover{
  border: 1px solid <[highlight]>;
  color: <[foreground]>;
}
QAbstractSpinBox:selected {
  background: <[highlight]>;
  color: <[accent]>;
}
/* ------------------------------------------------------------------------ */
/* DISPLAYS --------------------------------------------------------------- */
/* ------------------------------------------------------------------------ */
/* QLabel ----------------------------------------------------------------- */
QLabel {
  /*background-color: <[color]>;*/
  background-color: #505f69;
  border: 10px solid <[accent]>;
  padding: 2px;
  margin: 0px;
  color: <[foreground]>
}
QLabel::disabled {
  background-color: <[color]>;
  border: 0px solid <[accent]>;
  color: <[color]>;
}
/* QTextBrowser ----------------------------------------------------------- */
QTextBrowser {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  color: <[foreground]>;
  border-radius: 4px;
}
QTextBrowser:disabled {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  color: <[color]>;
  border-radius: 4px;
}
QTextBrowser:hover,
QTextBrowser:!hover,
QTextBrowser::selected,
QTextBrowser::pressed {
  border: 1px solid <[accent]>;
}
/* QGraphicsView --------------------------------------------------------- */
QGraphicsView {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  color: <[foreground]>;
  border-radius: 4px;
}
QGraphicsView:disabled {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  color: <[color]>;
  border-radius: 4px;
}
QGraphicsView:hover,
QGraphicsView:!hover,
QGraphicsView::selected,
QGraphicsView::pressed {
  border: 1px solid <[accent]>;
}
/* QCalendarWidget -------------------------------------------------------- */
QCalendarWidget {
  border: 1px solid <[accent]>;
  border-radius: 4px;
}
QCalendarWidget:disabled {
  background-color: <[color]>;
  color: <[color]>;
}
/* QLCDNumber ------------------------------------------------------------- */
QLCDNumber {
  background-color: <[color]>;
  color: <[foreground]>;
}
QLCDNumber:disabled {
  background-color: <[color]>;
  color: <[color]>;
}
/* QProgressBar ----------------------------------------------------------- */
QProgressBar {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  color: <[foreground]>;
  border-radius: 4px;
  text-align: center;
}
QProgressBar:disabled {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  color: <[color]>;
  border-radius: 4px;
  text-align: center;
}
QProgressBar::chunk {
  background-color: <[highlight]>;
  color: <[color]>;
  border-radius: 4px;
}
QProgressBar::chunk:disabled {
  background-color: #14506E;
  color: <[color]>;
  border-radius: 4px;
}
/* ------------------------------------------------------------------------ */
/* BUTTONS ---------------------------------------------------------------- */
/* ------------------------------------------------------------------------ */
/* QPushButton ------------------------------------------------------------ */
QPushButton {
  background-color: <[accent]> ;
  border: 1px solid <[accent]>;
  color: <[foreground]>;
  border-radius: 4px;
  padding: 3px;
  outline: none;
}
QPushButton:disabled {
  background-color: <[accent]>;
  border: 1px solid <[accent]>;
  color: <[color]>;
  border-radius: 4px;
  padding: 3px;
}
QPushButton:checked {
  background-color: <[accent]>;
  border: 1px solid <[accent]>;
  border-radius: 4px;
  padding: 3px;
  outline: none;
}
QPushButton:checked:disabled {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  color: <[color]>;
  border-radius: 4px;
  padding: 3px;
  outline: none;
}
QPushButton::menu-indicator {
  subcontrol-origin: padding;
  subcontrol-position: bottom right;
  bottom: 4px;
}
QPushButton:pressed {
  background-color: <[color]>;
  border: 1px solid <[color]>;
}
QPushButton:hover,
QPushButton:checked:hover{
  border: 1px solid <[highlight]>;
  color: <[foreground]>;
}
QPushButton:selected,
QPushButton:checked:selected{
  background: <[highlight]>;
  color: <[accent]>;
}
/* QToolButton ------------------------------------------------------------ */
QToolButton {
  background-color: transparent;
  border: 1px solid <[accent]>;
  border-radius: 4px;
  margin: 0px;
  padding: 2px;
}
QToolButton:checked {
  background-color: <[color]>;
  border: 1px solid <[color]>;
}
QToolButton:disabled {
  border: 1px solid <[accent]>;
}
QToolButton:hover,
QToolButton:checked:hover{
  border: 1px solid <[highlight]>;
}
/* the subcontrols below are used only in the MenuButtonPopup mode */
QToolButton[popupMode="1"] {
  padding: 2px;
  padding-right: 12px;   /* only for MenuButtonPopup */
  border: 1px solid <[accent]>;   /* make way for the popup button */
  border-radius: 4px;
}
/* The subcontrol below is used only in the InstantPopup or DelayedPopup mode */
QToolButton[popupMode="2"] {
  padding: 2px;
  padding-right: 12px;    /* only for InstantPopup */
  border: 1px solid <[accent]>;  /* make way for the popup button */
}
QToolButton::menu-button {
  padding: 2px;
  border-radius: 4px;
  border: 1px solid <[accent]>;
  border-top-right-radius: 4px;
  border-bottom-right-radius: 4px;
  /* 16px width + 4px for border = 20px allocated above */
  width: 16px;
  outline: none;
}
QToolButton::menu-button:hover,
QToolButton::menu-button:checked:hover {
  border: 1px solid <[highlight]>;
}
QToolButton::menu-indicator {
  image: url(:/qss_icons/rc/down_arrow.png);
  top: -8px;   /* shift it a bit */
  left: -4px;  /* shift it a bit */
}
QToolButton::menu-arrow {
  image: url(:/qss_icons/rc/down_arrow.png);
}
QToolButton::menu-arrow:open {
  border: 1px solid <[accent]>;
}
/* QCommandLinkButton ----------------------------------------------------- */
QCommandLinkButton {
  background-color: transparent;
  border: 1px solid <[accent]>;
  color: <[foreground]>;
  border-radius: 4px;
  padding: 0px;
  margin: 0px;
}
QCommandLinkButton:disabled {
  background-color: transparent;
  color: <[color]>;
}
/* ------------------------------------------------------------------------ */
/* INPUTS - NO FIELDS ----------------------------------------------------- */
/* ------------------------------------------------------------------------ */
/* QCombobox -------------------------------------------------------------- */
QComboBox {
  border: 1px solid <[accent]>;
  border-radius: 4px;
  selection-background-color: #000000;
  background-color: #FFFFFF;
  color: #000000;
  padding-top: 2px;   /* This fix  #103, #111*/
  padding-bottom: 2px;  /* This fix  #103, #111*/
  padding-left: 4px;
  padding-right: 4px;
  /* min-width: 75px;  removed to fix 109 */
}
QComboBox:disabled {
  background-color: #000000;
  color: #000000;
}
QComboBox:hover{
  border: 1px solid <[highlight]>;
}
QComboBox:on {
  selection-background-color: #000000;
}
QComboBox QAbstractItemView {
  background-color: #000000;
  border-radius: 4px;
  border: 1px solid <[accent]>;
  selection-color: <[highlight]>;
  selection-background-color: #000000;
}
QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 20px;
  border-left-width: 0px;
  border-left-color: <[accent]>;
  border-left-style: solid;
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
}
QComboBox::down-arrow {
  image: url(:/qss_icons/rc/down_arrow_disabled.png);
}
QComboBox::down-arrow:on,
QComboBox::down-arrow:hover,
QComboBox::down-arrow:focus {
  image: url(:/qss_icons/rc/down_arrow.png);
}
/* QSlider ---------------------------------------------------------------- */
QSlider:disabled {
  background: <[color]>;
}
QSlider:focus {
  border: none;
}
QSlider::groove:horizontal {
  background: <[accent]>;
  border: 1px solid <[accent]>;
  height: 4px;
  margin: 0px;
  border-radius: 4px;
}
QSlider::sub-page:horizontal {
  background: <[highlight]>;
  border: 1px solid <[accent]>;
  height: 4px;
  margin: 0px;
  border-radius: 4px;
}
QSlider::sub-page:horizontal:disabled {
  background: #14506E;
}
QSlider::handle:horizontal {
  background: <[color]>;
  border: 1px solid <[accent]>;
  width: 8px;
  height: 8px;
  margin: -8px 0;
  border-radius: 4px;
}
QSlider::handle:horizontal:hover {
  background: <[highlight]>;
  border: 1px solid <[highlight]>;
}
QSlider::groove:vertical {
  background: <[accent]>;
  border: 1px solid <[accent]>;
  width: 4px;
  margin: 0px;
  border-radius: 4px;
}
QSlider::sub-page:vertical {
  background: <[highlight]>;
  border: 1px solid <[accent]>;
  width: 4px;
  margin: 0px;
  border-radius: 4px;
}
QSlider::sub-page:vertical:disabled {
  background: #14506E;
}
QSlider::handle:vertical {
  background: <[color]>;
  border: 1px solid <[accent]>;
  width: 8px;
  height: 8px;
  margin: 0 -8px;
  border-radius: 4px;
}
QSlider::handle:vertical:hover {
  background: <[highlight]>;
  border: 1px solid <[highlight]>;
}
/* QLine ------------------------------------------------------------------ */
QLineEdit {
  background-color: #FFFFFF; /*<[color]>;*/
  padding-top: 2px;   /* This QLineEdit fix  103, 111 */
  padding-bottom: 2px;  /* This QLineEdit fix  103, 111 */
  padding-left: 4px;
  padding-right: 4px;
  border-style: solid;
  border: 1px solid <[accent]>;
  border-radius: 4px;
  color: #000000;
}
QLineEdit:disabled {
  background-color: <[color]>;
  color: <[color]>;
}
QLineEdit:hover{
  border: 1px solid <[highlight]>;
  color: <[foreground]>;
}
QLineEdit:selected{
  background: <[highlight]>;
  color: <[accent]>;
}
/* QTabWiget -------------------------------------------------------------- */
QTabWidget {
  padding: 2px;
  selection-background-color: <[color]>;
}
QTabWidget QFrame{
  border: 0;
}
QTabWidget::pane {
  border: 1px solid <[accent]>;
  border-radius: 4px;
  padding: 2px;
  margin: 0px;
}
QTabWidget::pane:selected {
  background-color: <[accent]>;
  border: 1px solid <[highlight]>;
}
/* QTabBar ---------------------------------------------------------------- */
QTabBar {
  qproperty-drawBase: 0;
  border-radius: 4px;
  margin: 0px;
  padding: 2px;
  border: 0;
  /* left: 5px; move to the right by 5px - removed for fix */
  }
QTabBar::close-button {
  border: 0;
  margin: 2px;
  padding: 0;
  image: url(:/qss_icons/rc/close.png);
}
QTabBar::close-button:hover {
  image: url(:/qss_icons/rc/close-hover.png);
}
QTabBar::close-button:pressed {
  image: url(:/qss_icons/rc/close-pressed.png);
}
/* QTabBar::tab - selected ----------------------------------------------- */
QTabBar::tab:top:selected:disabled {
  border-bottom: 3px solid #14506E;
  color: <[color]>;
  background-color: <[accent]>;
}
QTabBar::tab:bottom:selected:disabled {
  border-top: 3px solid #14506E;
  color: <[color]>;
  background-color: <[accent]>;
}
QTabBar::tab:left:selected:disabled {
  border-left: 3px solid #14506E;
  color: <[color]>;
  background-color: <[accent]>;
}
QTabBar::tab:right:selected:disabled {
  border-right: 3px solid #14506E;
  color: <[color]>;
  background-color: <[accent]>;
}
/* QTabBar::tab - !selected and disabled ---------------------------------- */
QTabBar::tab:top:!selected:disabled {
  border-bottom: 3px solid <[color]>;
  color: <[color]>;
  background-color: <[color]>;
}
QTabBar::tab:bottom:!selected:disabled {
  border-top: 3px solid <[color]>;
  color: <[color]>;
  background-color: <[color]>;
}
QTabBar::tab:left:!selected:disabled {
  border-right: 3px solid <[color]>;
  color: <[color]>;
  background-color: <[color]>;
}
QTabBar::tab:right:!selected:disabled {
  border-left: 3px solid <[color]>;
  color: <[color]>;
  background-color: <[color]>;
}
/* QTabBar::tab - selected ----------------------------------------------- */
QTabBar::tab:top:!selected {
  border-bottom: 2px solid <[color]>;
  margin-top: 2px;
}
QTabBar::tab:bottom:!selected {
  border-top: 2px solid <[color]>;
  margin-bottom: 3px;
}
QTabBar::tab:left:!selected {
  border-left: 2px solid <[color]>;
  margin-right: 2px;
}
QTabBar::tab:right:!selected {
  border-right: 2px solid <[color]>;
  margin-left: 2px;
}
QTabBar::tab:top {
  background-color: <[accent]>;
  color: <[foreground]>;
  margin-left: 2px;
  padding-left: 4px;
  padding-right: 4px;
  padding-top: 2px;
  padding-bottom: 2px;
  min-width: 5px;
  border-bottom: 3px solid <[accent]>;
  border-top-left-radius: 3px;
  border-top-right-radius: 3px;
}
QTabBar::tab:top:selected {
  background-color: #505F69;
  color: <[foreground]>;
  border-bottom: 3px solid <[highlight]>;
  border-top-left-radius: 3px;
  border-top-right-radius: 3px;
}
QTabBar::tab:top:!selected:hover {
  border: 1px solid <[highlight]>;
  border-bottom: 3px solid <[highlight]>;
  padding: 0px;
}
QTabBar::tab:bottom {
  color: <[foreground]>;
  border-top: 3px solid <[accent]>;
  background-color: <[accent]>;
  margin-left: 2px;
  padding-left: 4px;
  padding-right: 4px;
  padding-top: 2px;
  padding-bottom: 2px;
  border-bottom-left-radius: 3px;
  border-bottom-right-radius: 3px;
  min-width: 5px;
}
QTabBar::tab:bottom:selected {
  color: <[foreground]>;
  background-color: #505F69;
  border-top: 3px solid <[highlight]>;
  border-bottom-left-radius: 3px;
  border-bottom-right-radius: 3px;
}
QTabBar::tab:bottom:!selected:hover {
  border: 1px solid <[highlight]>;
  border-top: 3px solid <[highlight]>;
  padding: 0px;
}
QTabBar::tab:left {
  color: <[foreground]>;
  background-color: <[accent]>;
  margin-top: 2px;
  padding-left: 2px;
  padding-right: 2px;
  padding-top: 4px;
  padding-bottom: 4px;
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
  min-height: 5px;
}
QTabBar::tab:left:selected {
  color: <[foreground]>;
  background-color: #505F69;
  border-left: 3px solid <[highlight]>;
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
}
QTabBar::tab:left:!selected:hover {
  border: 1px solid <[highlight]>;
  border-left: 3px solid <[highlight]>;
  padding: 0px;
}
QTabBar::tab:right {
  color: <[foreground]>;
  background-color: <[accent]>;
  margin-top: 2px;
  padding-left: 2px;
  padding-right: 2px;
  padding-top: 4px;
  padding-bottom: 4px;
  border-top-left-radius: 3px;
  border-bottom-left-radius: 3px;
  min-height: 5px;
}
QTabBar::tab:right:selected {
  color: <[foreground]>;
  background-color: #505F69;
  border-right: 3px solid <[highlight]>;
  border-top-left-radius: 3px;
  border-bottom-left-radius: 3px;
}
QTabBar::tab:right:!selected:hover {
  border: 1px solid <[highlight]>;
  border-right: 3px solid <[highlight]>;
  padding: 0px;
}
QTabBar QToolButton::right-arrow:enabled {
  image: url(:/qss_icons/rc/right_arrow.png);
}
QTabBar QToolButton::left-arrow:enabled {
  image: url(:/qss_icons/rc/left_arrow.png);
}
QTabBar QToolButton::right-arrow:disabled {
  image: url(:/qss_icons/rc/right_arrow_disabled.png);
}
QTabBar QToolButton::left-arrow:disabled {
  image: url(:/qss_icons/rc/left_arrow_disabled.png);
}
/*  Some examples from internet to check
QTabBar::tabButton() and QTabBar::tabIcon()
QTabBar::tear {width: 0px; border: none;}
QTabBar::tear {image: url(tear_indicator.png);}
QTabBar::scroller{width:85pix;}
QTabBar QToolbutton{background-color:"light blue";}
But that left the buttons transparant.
Looked confusing as the tab buttons migrated behind the scroller buttons.
So we had to color the back ground of the scroller buttons
*/
/* QDockWiget ------------------------------------------------------------- */
QDockWidget {
  outline: 1px solid <[accent]>;
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  border-radius: 4px;
  titlebar-close-icon: url(:/qss_icons/rc/close.png);
  titlebar-normal-icon: url(:/qss_icons/rc/undock.png);
}
QDockWidget::title {
  padding: 6px;   /* better size for title bar */
  border: none;
  background-color: <[accent]>;
}
QDockWidget::close-button {
  background-color: <[accent]>;
  border-radius: 4px;
  border: none;
}
QDockWidget::close-button:hover {
  border: 1px solid <[accent]>;
}
QDockWidget::close-button:pressed {
  border: 1px solid <[accent]>;
}
QDockWidget::float-button {
  background-color: <[accent]>;
  border-radius: 4px;
  border: none;
}
QDockWidget::float-button:hover {
  border: 1px solid <[accent]>;
}
QDockWidget::float-button:pressed {
  border: 1px solid <[accent]>;
}
/* QTreeView QTableView QListView ----------------------------------------- */
QTreeView:branch:selected,
/*QTreeView:branch:hover {
  background: url(:/qss_icons/rc/transparent.png);
}
QTreeView::branch:has-siblings:!adjoins-item {
  border-image: url(:/qss_icons/rc/transparent.png);
}
QTreeView::branch:has-siblings:adjoins-item {
  border-image: url(:/qss_icons/rc/transparent.png);
}
QTreeView::branch:!has-children:!has-siblings:adjoins-item {
  border-image: url(:/qss_icons/rc/transparent.png);
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
  image: url(:/img/stylesheet-branch-closed.png);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
  image: url(:/qss_icons/rc/branch_open.png);
}
QTreeView::branch:has-children:!has-siblings:closed:hover,
QTreeView::branch:closed:has-children:has-siblings:hover {
  image: url(:/qss_icons/rc/branch_closed-on.png);
}
QTreeView::branch:open:has-children:!has-siblings:hover,
QTreeView::branch:open:has-children:has-siblings:hover {
  image: url(:/qss_icons/rc/branch_open-on.png);
}*/
QListView::item:!selected:hover,
QTreeView::item:!selected:hover,
QTableView::item:!selected:hover,
QColumnView::item:!selected:hover {
  outline: 0;
  color: #000000;
}
QListView::item:selected:hover,
QTreeView::item:selected:hover,
QTableView::item:selected:hover,
QColumnView::item:selected:hover {
  background: <[highlight]>;
  color:  #000000;
}
QTreeView::indicator:checked,
QListView::indicator:checked {
  image: url(:/qss_icons/rc/checkbox_checked.png);
}
QTreeView::indicator:unchecked,
QListView::indicator:unchecked {
  image: url(:/qss_icons/rc/checkbox_unchecked.png);
}
QTreeView::indicator:checked:hover,
QTreeView::indicator:checked:focus,
QTreeView::indicator:checked:pressed,
QListView::indicator:checked:hover,
QListView::indicator:checked:focus,
QListView::indicator:checked:pressed {
  image: url(:/qss_icons/rc/checkbox_checked_focus.png);
}
QTreeView::indicator:unchecked:hover,
QTreeView::indicator:unchecked:focus,
QTreeView::indicator:unchecked:pressed,
QListView::indicator:unchecked:hover,
QListView::indicator:unchecked:focus,
QListView::indicator:unchecked:pressed {
  image: url(:/qss_icons/rc/checkbox_unchecked_focus.png);
}
QTreeView::indicator:indeterminate:hover,
QTreeView::indicator:indeterminate:focus,
QTreeView::indicator:indeterminate:pressed,
QListView::indicator:indeterminate:hover,
QListView::indicator:indeterminate:focus,
QListView::indicator:indeterminate:pressed {
  image: url(:/qss_icons/rc/checkbox_indeterminate_focus.png);
}
QTreeView::indicator:indeterminate,
QListView::indicator:indeterminate {
  image: url(:/qss_icons/rc/checkbox_indeterminate.png);
}
QListView,
QTreeView,
QTableView,
QColumnView {
  background-color: #000000;
  border: 1px solid <[accent]>;
  color: <[foreground]>;
  gridline-color: #FFFFFF;
  border-radius: 4px;
}
QListView:disabled,
QTreeView:disabled,
QTableView:disabled,
QColumnView:disabled {
  background-color: #000000;
  color: <[color]>;
}
QListView:selected,
QTreeView:selected,
QTableView:selected,
QColumnView:selected {
  background: <[highlight]>;
  color: <[accent]>;
}
QListView:hover,
QTreeView::hover,
QTableView::hover,
QColumnView::hover {
  background-color: <[color]>;
  border: 1px solid <[highlight]>;
}
QListView::item:pressed,
QTreeView::item:pressed,
QTableView::item:pressed,
QColumnView::item:pressed {
  background-color: <[highlight]>;
}
QListView::item:selected:active,
QTreeView::item:selected:active,
QTableView::item:selected:active,
QColumnView::item:selected:active {
  background-color: <[highlight]>;
}
QTableCornerButton::section {
  background-color: <[color]>;
  border: 1px transparent <[accent]>;
  border-radius: 0px;
}
/* QHeaderView ------------------------------------------------------------ */
QHeaderView {
  background-color: <[accent]>;
  border: 0px transparent <[accent]>;
  padding: 0px;
  margin: 0px;
  border-radius: 0px;
}
QHeaderView:disabled {
  background-color: <[accent]>;
  border: 1px transparent <[accent]>;
  padding: 2px;
}
QHeaderView::section {
  background-color: <[accent]>;
  color: <[foreground]>;
  padding: 2px;
  border-radius: 0px;
  text-align: left;
}
QHeaderView::section:checked {
  color: <[foreground]>;
  background-color: <[highlight]>;
}
QHeaderView::section:checked:disabled {
  color: <[color]>;
  background-color: #14506E;
}
QHeaderView::section::horizontal:disabled,
QHeaderView::section::vertical:disabled {
  color: <[color]>;
}
QHeaderView::section::vertical::first,
QHeaderView::section::vertical::only-one {
  border-top: 1px solid <[accent]>;
}
QHeaderView::section::vertical {
  border-top: 1px solid <[color]>;
}
QHeaderView::section::horizontal::first,
QHeaderView::section::horizontal::only-one {
  border-left: 1px solid <[accent]>;
}
QHeaderView::section::horizontal {
  border-left: 1px solid <[color]>;
}
/* Those settings (border/width/height/background-color) solve bug */
/* transparent arrow background and size */
QHeaderView::down-arrow {
  background-color: <[accent]>;
  width: 16px;
  height: 16px;
  border-right: 1px solid <[color]>;
  image: url(:/qss_icons/rc/down_arrow.png);
}
QHeaderView::up-arrow {
  background-color: <[accent]>;
  width: 16px;
  height: 16px;
  border-right: 1px solid <[color]>;
  image: url(:/qss_icons/rc/up_arrow.png);
}
/* QToolBox -------------------------------------------------------------- */
QToolBox {
  padding: 0px;
  border: 1px solid <[accent]>;
}
QToolBox::selected {
  padding: 0px;
  border: 2px solid <[highlight]>;
}
QToolBox::tab {
  background-color: <[color]>;
  border: 1px solid <[accent]>;
  color: <[foreground]>;
  border-top-left-radius: 4px;
  border-top-right-radius: 4px;
}
QToolBox::tab:disabled {
  color: <[color]>;
}
QToolBox::tab:selected {
  background-color: #505F69;
  border-bottom: 2px solid <[highlight]>;
}
QToolBox::tab:!selected {
  background-color: <[accent]>;
  border-bottom: 2px solid <[accent]>;
}
QToolBox::tab:selected:disabled {
  background-color: <[accent]>;
  border-bottom: 2px solid #14506E;
}
QToolBox::tab:!selected:disabled {
  background-color: <[color]>;
}
QToolBox::tab:hover {
  border-color: <[highlight]>;
  border-bottom: 2px solid <[highlight]>;
}
QToolBox QScrollArea QWidget QWidget {
  padding: 0px;
  background-color: #000000;
}
/* QFrame ----------------------------------------------------------------- */
QFrame {
  border-radius: 4px;
  border: 1px solid <[accent]>;
}
QFrame[frameShape="0"] {
  border-radius: 4px;
  border: 1px transparent <[accent]>;
}
QFrame[height="3"],
QFrame[width="3"] {
  background-color: #000000;
}
/* QSplitter -------------------------------------------------------------- */
QSplitter {
  background-color: <[accent]>;
  spacing: 0;
  padding: 0;
  margin: 0;
}
QSplitter::separator {
  background-color: <[accent]>;
  border: 0 solid #000000;
  spacing: 0;
  padding: 1px;
  margin: 0;
}
QSplitter::separator:hover {
  background-color: <[color]>;
}
QSplitter::separator:horizontal {
  width: 5px;
  image: url(:/qss_icons/rc/Vsepartoolbar.png);
}
QSplitter::separator:vertical {
  height: 5px;
  image: url(:/qss_icons/rc/Hsepartoolbar.png);
}
/* QDateEdit-------------------------------------------------------------- */
QDateEdit {
  selection-background-color: <[highlight]>;
  border-style: solid;
  border: 1px solid <[accent]>;
  border-radius: 4px;
  padding-top: 2px;   /* This fix  #103, #111*/
  padding-bottom: 2px;  /* This fix  #103, #111*/
  padding-left: 4px;
  padding-right: 4px;
  min-width: 10px;
}
QDateEdit:on {
  selection-background-color: <[highlight]>;
}
QDateEdit::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 20px;
  border-top-right-radius: 3px;
  border-bottom-right-radius: 3px;
}
QDateEdit::down-arrow {
  image: url(:/qss_icons/rc/down_arrow_disabled.png);
}
QDateEdit::down-arrow:on,
QDateEdit::down-arrow:hover,
QDateEdit::down-arrow:focus {
  image: url(:/qss_icons/rc/down_arrow.png);
}
QDateEdit QAbstractItemView {
  background-color: #000000;
  border-radius: 4px;
  border: 1px solid <[accent]>;
  selection-background-color: <[highlight]>;
}
QAbstractView:hover{
  border: 1px solid <[highlight]>;
  color: <[foreground]>;
}
QAbstractView:selected {
  background: <[highlight]>;
  color: <[accent]>;
}
